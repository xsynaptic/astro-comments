{
	"name": "@xsynaptic/astro-comments",
	"version": "0.6.0",
	"description": "Static, moderated comments for Astro sites: a submission handler with pluggable storage and spam checks, build-time rendering, and a headless form element",
	"type": "module",
	"license": "MIT",
	"author": "Alexander Synaptic <x@synapticism.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xsynaptic/astro-comments.git"
	},
	"homepage": "https://github.com/xsynaptic/astro-comments#readme",
	"bugs": {
		"url": "https://github.com/xsynaptic/astro-comments/issues"
	},
	"keywords": [
		"astro",
		"cloudflare-d1",
		"comments",
		"custom-element",
		"moderation",
		"static-comments",
		"turnstile",
		"withastro"
	],
	"packageManager": "pnpm@12.23.0",
	"engines": {
		"node": ">=24.0.0"
	},
	"sideEffects": false,
	"bin": {
		"astro-comments": "./dist/bin.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./cli": {
			"types": "./dist/cli.d.mts",
			"import": "./dist/cli.mjs"
		},
		"./cloudflare": {
			"types": "./dist/cloudflare.d.mts",
			"import": "./dist/cloudflare.mjs"
		},
		"./cloudflare/node": {
			"types": "./dist/cloudflare-node.d.mts",
			"import": "./dist/cloudflare-node.mjs"
		},
		"./cloudflare/widget": {
			"types": "./dist/cloudflare-widget.d.mts",
			"import": "./dist/cloudflare-widget.mjs"
		},
		"./config": {
			"types": "./dist/config.d.mts",
			"import": "./dist/config.mjs"
		},
		"./element": {
			"types": "./dist/element.d.mts",
			"import": "./dist/element.mjs"
		},
		"./import": {
			"types": "./dist/import.d.mts",
			"import": "./dist/import.mjs"
		},
		"./migrations/*": "./migrations/*",
		"./render": {
			"types": "./dist/render.d.mts",
			"import": "./dist/render.mjs"
		},
		"./snapshot": {
			"types": "./dist/snapshot.d.mts",
			"import": "./dist/snapshot.mjs"
		}
	},
	"imports": {
		"#*": "./src/*"
	},
	"files": [
		"dist",
		"migrations",
		"src",
		"!src/**/*.test.ts"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "pnpm build && playwright test",
		"verify:consumer": "node verify/consumer/smoke.ts",
		"check-types": "tsc -p tsconfig.json",
		"lint": "eslint --max-warnings 0",
		"fix": "lefthook run fix",
		"check": "lefthook run check",
		"size": "size-limit",
		"version-packages": "changeset version && pnpm install --ignore-scripts",
		"release": "node scripts/release.ts"
	},
	"dependencies": {
		"htmlparser2": "^12.0.0",
		"markdown-it": "^15.0.3",
		"sanitize-html": "^2.18.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@fast-check/vitest": "^0.6.0",
		"@playwright/test": "^1.65.1",
		"@size-limit/preset-small-lib": "^14.3.0",
		"@size-limit/rolldown-why": "^14.3.0",
		"@types/node": "^24.19.4",
		"@types/sanitize-html": "^2.16.2",
		"@xsynaptic/eslint-config": "^6.10.0",
		"eslint": "^10.15.0",
		"globals": "^17.14.0",
		"happy-dom": "^21.0.4",
		"jiti": "^2.7.0",
		"knip": "^6.48.0",
		"lefthook": "^2.2.3",
		"prettier": "^3.10.1",
		"prettier-plugin-astro": "^1.1.2",
		"publint": "^0.3.25",
		"size-limit": "^14.3.0",
		"tsdown": "^0.23.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vitest": "^5.1.2",
		"wrangler": "^4.168.0"
	},
	"peerDependencies": {
		"wrangler": "^4.165.0"
	},
	"peerDependenciesMeta": {
		"wrangler": {
			"optional": true
		}
	}
}
